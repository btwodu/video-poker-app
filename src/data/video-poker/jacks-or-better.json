  "strategy": {
    "title": "9/6 Jacks — core hold order",
    "note": "Play the first line that fits your hand.",
    "sources": [
      "solver"
    ],
    "lines": [
      {
        "text": "Four of a kind, straight flush, royal flush",
        "rule": "made:royal,sf,quads",
        "example": {
          "hand": "Tc Jc Qc Kc Ac",
          "hold": "Tc Jc Qc Kc Ac"
        }
      },
      {
        "text": "Four to a royal — even breaking a made flush",
        "rule": "royal:4",
        "example": {
          "hand": "As Ks Qs Js 4s",
          "hold": "As Ks Qs Js"
        }
      },
      {
        "text": "Three of a kind, straight, flush, full house",
        "rule": "made:fullhouse,flush,straight|kind:3",
        "example": {
          "hand": "9c 9d 9h Ks 4d",
          "hold": "9c 9d 9h"
        }
      },
      {
        "text": "Four to a straight flush",
        "rule": "sf:4",
        "example": {
          "hand": "5h 6h 7h 8h 8s",
          "hold": "5h 6h 7h 8h"
        }
      },
      {
        "text": "Two pair",
        "rule": "twopair",
        "example": {
          "hand": "Jc Jd 4s 4h As",
          "hold": "Jc Jd 4s 4h"
        }
      },
      {
        "text": "High pair (jacks or better) — over four to a flush",
        "rule": "pair:high",
        "example": {
          "hand": "Kc Kd 2c 5c 9c",
          "hold": "Kc Kd"
        }
      },
      {
        "text": "Three to a royal",
        "rule": "royal:3",
        "example": {
          "hand": "Kh Qh Th 7c 3d",
          "hold": "Kh Qh Th"
        }
      },
      {
        "text": "Four to a flush — over a low pair",
        "rule": "flush:4",
        "example": {
          "hand": "8c 8d 2c 5c Kc",
          "hold": "8c 2c 5c Kc"
        }
      },
      {
        "text": "K-Q-J-10 of any suits — over a pair of tens",
        "rule": "straight:4:out:h>=3",
        "example": {
          "hand": "2c Tc Jc Qd Kh",
          "hold": "Tc Jc Qd Kh"
        }
      },
      {
        "text": "Low pair — over four to a straight",
        "rule": "pair:low",
        "example": {
          "hand": "8c 8d 9h Ts Jd",
          "hold": "8c 8d"
        }
      },
      {
        "text": "Four to an outside straight",
        "rule": "straight:4:out",
        "example": {
          "hand": "8c 9d Th Js 2d",
          "hold": "8c 9d Th Js"
        }
      },
      {
        "text": "Unsuited A-K-Q-J — hold all four",
        "rule": "ranks:a:AKQJ",
        "example": {
          "hand": "Ad Kc Qc Js 4d",
          "hold": "Ad Kc Qc Js"
        }
      },
      {
        "text": "Three to a straight flush — touching cards (3-4-5 or higher), or containing two high cards",
        "rule": "sf:3:t>=0:lo>=3",
        "example": {
          "hand": "4c 5c 6c 9d Th",
          "hold": "4c 5c 6c"
        }
      },
      {
        "text": "Two suited high cards",
        "rule": "ranks:s:QJ,KQ,KJ,AK,AQ,AJ",
